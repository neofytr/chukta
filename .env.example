# Copy to .env. Without these, Chukta still runs and holds whatever it cannot verify.
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
# OpenAI-compatible endpoint serving deepseek/deepseek-v4.1-flash. Send fictional data only on a free key.
LLM_BASE_URL=
LLM_API_KEY=
# Test-mode keys only. Chukta refuses a live key and falls back to its local sandbox.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional receipts by email. Mail goes only to RECEIPT_TEST_INBOX, never to a real vendor.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RECEIPT_FROM=
RECEIPT_TEST_INBOX=
