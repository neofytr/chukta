# Copy to .env. Without these, Chukta still runs and holds whatever it cannot verify.
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
# OpenAI-compatible endpoint serving deepseek/deepseek-v4.1-flash. Send fictional data only on a free key.
LLM_BASE_URL=
LLM_API_KEY=
# Test-mode keys only. Chukta refuses a live key and falls back to its local sandbox.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
